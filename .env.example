# Copy to .env. The anthropic SDK also reads ANTHROPIC_API_KEY / an `ant auth login`
# profile on its own, so HALFLIFE_ANTHROPIC_API_KEY is only needed to force a specific key.
# HALFLIFE_ANTHROPIC_API_KEY=

# Defaults to ~/.halflife/halflife.db
# HALFLIFE_DB_URL=sqlite+pysqlite:///./halflife.db

# HALFLIFE_MODEL_ID=claude-opus-5
# HALFLIFE_EFFORT=high
# HALFLIFE_MAX_TOKENS=16000
# HALFLIFE_WORDS_PER_MINUTE=200
# HALFLIFE_SERIES_PLAN_LENGTH=10
